# ---- Google OAuth ----
# From https://console.cloud.google.com/apis/credentials
# Add your site origin (e.g. http://localhost:3000) to authorized JS origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Server-only secrets (never expose to the browser) ----
# Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_test_...

# Stripe → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- reCAPTCHA v3 ----
# From https://www.google.com/recaptcha/admin (choose v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY
